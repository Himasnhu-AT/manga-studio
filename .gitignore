stories/*
!stories/cheek-squish/
stories/*/out/
stories/*/final/
stories/*/state.json
.DS_Store

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
.claude/settings.local.json
.studio/
.claude/worktrees/

# local agent notes (not published)
HANDOFF.md

# release builds (scripts/release-mac.sh)
/dist/
