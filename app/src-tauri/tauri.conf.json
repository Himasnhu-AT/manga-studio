{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manga Studio",
  "version": "0.2.0",
  "identifier": "dev.mangastudio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Manga Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#f4f4f2",
        "label": "main",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "GraphicsAndDesign",
    "resources": {
      "../../pyproject.toml": "backend/pyproject.toml",
      "../../uv.lock": "backend/uv.lock",
      "../../studio/*.py": "backend/studio/",
      "../../studio/pipeline/*.py": "backend/studio/pipeline/",
      "../../templates/*": "backend/templates/",
      "../../dashboard/*": "backend/dashboard/",
      "../../fonts/*": "backend/fonts/",
      "../../stories/cheek-squish/story.yaml": "backend/stories/cheek-squish/story.yaml",
      "../../stories/cheek-squish/refs/*": "backend/stories/cheek-squish/refs/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
